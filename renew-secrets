#!/usr/bin/env bash
# Renew, from this computer, the logins a copy of the suite on a server cannot renew by itself.
#
#   ./renew-secrets              renew what has lapsed here (./auth), then send the server fresh AWS
#                                credentials and Google tokens, and check the server's backend accepts them
#   ./renew-secrets --check      report what is here and on the server, and when the AWS credentials run
#                                out; send nothing
#   ./renew-secrets --first      as the default, and also send the Google OAuth client files and
#                                audiobook's Hugging Face token (once, when the server is set up)
#   ./renew-secrets --no-auth    skip ./auth: send what this computer already holds
#
# The server has no browser and no AWS SSO, so it cannot renew anything. This sends what this
# computer's own logins produce, over ssh (which, for a server reached through SSM, runs through
# `aws ssm start-session`; README -> "On a server"). Secrets travel on ssh's standard input, never
# in a command line: a command line would show in `ps` and, over SSM's send-command, be kept in the
# account's command history and CloudTrail.
#
# What it sends, and where it lands on the server (all paths relative to that user's home):
#   AWS     temporary credentials for $AWS_PROFILE  ->  $SUITE_REMOTE_AWS_DIR/credentials  (mode 600)
#           A folder of its own, so ~/.aws on a shared machine is never touched. Put its full path in
#           the server's .env as AWS_CONFIG_DIR; compose mounts it as the container's ~/.aws.
#   Google  docu-ai and mail-ai token files        ->  $SUITE_REMOTE_DIR/data/config/...
#
# AWS credentials from SSO last as long as the permission set's session (about 8 hours here), so this
# moves the lapse from "overnight" to "every few hours" -- an instance role would end it. The backend
# reads the credentials file on every model call, so nothing needs restarting afterwards.
#
# Settings, in .env: SUITE_REMOTE (required: an ssh host alias), SUITE_REMOTE_DIR (default: suite),
# SUITE_REMOTE_AWS_DIR (default: suite-aws). SUITE_SSH replaces `ssh` (used by the tests).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
if [[ -f .env ]]; then set -a; source .env; set +a; fi

mode=push; first=0; run_auth=1
for arg in "$@"; do
  case "$arg" in
    --check)   mode=check ;;
    --first)   first=1 ;;
    --no-auth) run_auth=0 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) echo "unknown option: $arg  (try --help)" >&2; exit 2 ;;
  esac
done

[[ -x .venv/bin/python ]] || { echo "Not set up yet. Run ./setup first." >&2; exit 1; }
REMOTE="${SUITE_REMOTE:-}"
if [[ -z "$REMOTE" ]]; then
  echo "SUITE_REMOTE is not set. Put the ssh host alias of the server in .env (README -> \"On a server\")." >&2
  exit 1
fi
read -ra SSH <<<"${SUITE_SSH:-ssh}"
REMOTE_DIR="${SUITE_REMOTE_DIR:-suite}"
REMOTE_AWS_DIR="${SUITE_REMOTE_AWS_DIR:-suite-aws}"
PROFILE="${AWS_PROFILE:-ayadata-bedrock}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
q_dir="$(printf %q "$REMOTE_DIR")"; q_aws="$(printf %q "$REMOTE_AWS_DIR")"

remote() { "${SSH[@]}" "$REMOTE" "$@"; }

# What the AWS login produces right now, held in memory only. `printf` is a shell builtin, so the
# secrets never appear in another process's arguments.
get_creds() {
  aws configure export-credentials --profile "$PROFILE" --format process 2>/dev/null \
    || { echo "No AWS credentials for $PROFILE. Run ./auth (or: aws sso login --profile $PROFILE)." >&2; return 1; }
}
expiry() {  # JSON on stdin -> "<local time> <minutes left>"
  .venv/bin/python -c '
import datetime as dt, json, sys
e = dt.datetime.fromisoformat(json.load(sys.stdin)["Expiration"].replace("Z", "+00:00"))
left = int((e - dt.datetime.now(dt.timezone.utc)).total_seconds() // 60)
print(e.astimezone().strftime("%a %d %b %H:%M %Z"), left)'
}
as_ini() {  # JSON on stdin -> an AWS credentials file on stdout
  .venv/bin/python -c '
import json, sys
d = json.load(sys.stdin)
print("[" + sys.argv[1] + "]")
print("aws_access_key_id = " + d["AccessKeyId"])
print("aws_secret_access_key = " + d["SecretAccessKey"])
if d.get("SessionToken"):
    print("aws_session_token = " + d["SessionToken"])' "$PROFILE"
}

report_expiry() {
  local creds read_out when left
  creds="$(get_creds)" || return 1
  read_out="$(printf '%s' "$creds" | expiry)"
  left="${read_out##* }"; when="${read_out% *}"
  echo "AWS credentials for $PROFILE run out: $when  (in $((left / 60)) h $((left % 60)) min)"
  (( left >= 120 )) || echo "  That is under two hours. Run ./auth, then this again, for a fresh set."
}

# Does the server's backend accept what is there? Never fatal: before the first start there is no container.
verify() {
  echo "On the server, the backend sees:"
  remote "docker exec -i suite-backend-1 /app/.venv/bin/python -" <<'PY' 2>&1 | sed 's/^/  /' || true
import os, boto3
try:
    s = boto3.Session(profile_name=os.environ["AWS_PROFILE"])
    print(s.client("sts", region_name=os.environ.get("AWS_REGION")).get_caller_identity()["Arn"])
except Exception as e:
    print("not working yet:", type(e).__name__, str(e)[:160])
PY
}

if [[ "$mode" == check ]]; then
  ./auth --check || true
  echo; report_expiry || true
  echo; echo "On the server ($REMOTE), what is there (names and times only):"
  remote "ls -l --time-style=long-iso $q_aws/credentials $q_dir/data/config/docu-ai/token.json $q_dir/data/config/mail-ai/token*.json 2>&1" | sed 's/^/  /' || true
  echo; verify
  exit 0
fi

if (( run_auth )); then ./auth; fi

echo "Reaching $REMOTE ..."
remote true || {
  echo "Could not reach $REMOTE. For a server reached through SSM the SSO login in its ProxyCommand may have" >&2
  echo "lapsed: aws sso login --profile <the profile in ~/.ssh/config for $REMOTE>" >&2
  exit 1
}

creds="$(get_creds)"
printf '%s' "$creds" | as_ini \
  | remote "umask 077; mkdir -p $q_aws && cat > $q_aws/credentials.new && mv $q_aws/credentials.new $q_aws/credentials"
unset creds
echo "Sent AWS credentials  -> $REMOTE_AWS_DIR/credentials"
report_expiry

files=()
for f in docu-ai/token.json mail-ai/token.json mail-ai/token-compose.json; do
  [[ -f "$CONFIG/$f" ]] && files+=("$f")
done
if (( ${#files[@]} )); then
  tar -C "$CONFIG" -cf - "${files[@]}" \
    | remote "umask 077; mkdir -p $q_dir/data/config && tar -C $q_dir/data/config -xf -"
  echo "Sent Google tokens    -> $REMOTE_DIR/data/config/  (${files[*]})"
else
  echo "No Google tokens under $CONFIG; sent none." >&2
fi

if (( first )); then
  once=()
  for f in docu-ai/credentials.json mail-ai/credentials.json audiobook/.env; do
    [[ -f "$f" ]] && once+=("$f")
  done
  tar -cf - "${once[@]}" | remote "umask 077; mkdir -p $q_dir/data && tar -C $q_dir/data -xf -"
  echo "Sent client files     -> $REMOTE_DIR/data/  (${once[*]})"
fi

echo; verify
