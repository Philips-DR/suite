# Settings for the whole suite. ./start reads this and every tool inherits it.
# Copy to .env and edit; .env itself is never committed.

# The model, reached through AWS Bedrock with an SSO profile.
AWS_PROFILE=ayadata-bedrock
AWS_REGION=us-east-1

# The backend's API. It only ever listens on 127.0.0.1. (The web app is on 8751; see web/.)
ASSISTANT_PORT=8750
# A fixed access token, so the web app does not ask for it again after every restart. Leave
# unset for a new random token on every launch, which is safer on a shared machine.
# ASSISTANT_TOKEN=
