# Settings for the whole suite. ./start reads this and every tool inherits it.
# Copy to .env and edit; .env itself is never committed.

# The model, reached through AWS Bedrock with an SSO profile.
AWS_PROFILE=ayadata-bedrock
AWS_REGION=us-east-1

# The backend's API. It only ever listens on 127.0.0.1. (The web app is on 8751; see web/.)
ASSISTANT_PORT=8750
# The access token between the web app and the backend. ./start makes a new random one on
# every launch and hands it to both, so there is nothing to set. Fix one here only if you run
# the backend and the web app separately and want them to agree without pasting.
# ASSISTANT_TOKEN=

# --- Google sign-in (optional: the assistant's own login, not the tool credentials) ----------------
# Create a Web Application OAuth client in the same Google Cloud project as docu-ai/mail-ai,
# scopes openid and email only, redirect URI matching GOOGLE_REDIRECT_URI below.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8750/auth/callback
# Comma-separated Google account emails allowed to sign in.
# ASSISTANT_ALLOWED_EMAILS=you@gmail.com

# --- ngrok (./start --ngrok or ./start-docker up --ngrok) ------------------------------------------
# An ngrok auth token (https://dashboard.ngrok.com/get-started/your-authtoken). Each tunnel gets a
# random HTTPS hostname; the scripts discover the URLs from ngrok's local API at startup.
# NGROK_AUTHTOKEN=
# A free static domain for the web app (https://dashboard.ngrok.com/domains), so the URL stays
# the same across restarts. The API tunnel stays random and is discovered automatically.
# NGROK_WEB_DOMAIN=your-name.ngrok-free.dev

# --- Containers (./start-docker) -------------------------------------------------------------------
# The name your devices reach it by over Tailscale, e.g. suite.tail1234.ts.net -- shown in the
# Tailscale admin console once the `suite` machine has joined. Until it is set, the container setup
# works on localhost only.
# SUITE_HOST=
# A Tailscale auth key (a reusable, tagged one for an always-on server), so the `suite` machine joins
# without a sign-in link. Left empty, its log prints a link to open once.
# TS_AUTHKEY=
# Fix a token across restarts (otherwise ./start-docker makes a new one each time it runs).
# ASSISTANT_TOKEN=

# --- A server you renew logins for (./renew-secrets) -----------------------------------------------
# The ssh host alias of the machine running ./start-docker, reached however you reach it (for a server
# behind SSM, an alias whose ProxyCommand runs `aws ssm start-session`; README -> "On a server").
# SUITE_REMOTE=
# Where the suite lives there (relative to that user's home), and the folder that holds only the suite's
# AWS credentials. Set AWS_CONFIG_DIR to the second one's full path in the *server's* .env.
# SUITE_REMOTE_DIR=suite
# SUITE_REMOTE_AWS_DIR=suite-aws
