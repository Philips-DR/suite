# Settings for the whole suite. ./start reads this and every tool inherits it.
# Copy to .env and edit; .env itself is never committed.

# The model, reached through AWS Bedrock with an SSO profile.
AWS_PROFILE=ayadata-bedrock
AWS_REGION=us-east-1

# The web app. It only ever listens on 127.0.0.1.
ASSISTANT_PORT=8750
# A fixed token, so a browser tab survives a restart. Leave unset for a new random token
# on every launch, which is safer on a shared machine.
# ASSISTANT_TOKEN=
