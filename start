#!/usr/bin/env bash
# The whole suite, as one command -- two separate programs, started side by side:
#
#   backend   assistant/assistant-web   http://127.0.0.1:8750  (API; starts meet-ai, docu-ai
#                                                               and mail-ai as its children)
#   web app   web/serve                 http://127.0.0.1:8751  (the page you open)
#
# Either can be run alone with its own command. Ctrl-C stops both; if either one stops,
# so does the other, rather than leaving half the suite running. A transcription or
# recording in progress is built to outlive this and is picked up again next time.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

[[ -x .venv/bin/python ]] || { echo "Not set up yet. Run ./setup first." >&2; exit 1; }

# One place for settings. Exported so the backend and every tool it starts inherit them.
if [[ -f .env ]]; then set -a; source .env; set +a; fi

# One token for this launch, made here and handed to both programs: the backend requires
# it, and the web app's server writes it into the page it serves. Nobody copies it anywhere.
# New on every launch unless .env fixes one.
if [[ -z "${ASSISTANT_TOKEN:-}" ]]; then
  ASSISTANT_TOKEN="$(.venv/bin/python -c 'import secrets; print(secrets.token_urlsafe(24))')"
fi
export ASSISTANT_TOKEN

assistant/assistant-web "$@" &
backend=$!
web/serve &
web=$!

stop() { kill "$backend" "$web" 2>/dev/null || true; wait 2>/dev/null || true; }
trap stop INT TERM EXIT

# Returns when the first of the two exits; the trap then stops the other.
wait -n "$backend" "$web"
