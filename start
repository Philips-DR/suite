#!/usr/bin/env bash
# The whole suite, as one command. It checks every login and renews the dead ones, then starts the
# containers (./start-docker up): the backend with every tool, the web app, and the database.
#
#   ./start               then open http://127.0.0.1:8751/
#   ./start --ngrok       also open HTTPS tunnels through ngrok (needs NGROK_AUTHTOKEN in .env)
#   ./start --tailscale   also join your tailnet (see README.md -> In containers)
#
# Anything after ./start goes to ./start-docker up unchanged. The containers keep running (and come
# back after a reboot) until ./start-docker down. There is no host-only way to run the suite any more:
# the database it keeps its memory in is a container, so there is one way and it is this one.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

# AWS SSO lapses overnight and the model will not work without it; Google tokens lapse weekly. A renewal
# that needs a browser opens one; if no browser is available the login stays dead and the start continues.
# (The pipe makes `|| true` redundant but harmless: sed's status is the one that counts.)
./auth 2>&1 | sed 's/^/  /' || true

exec ./start-docker up "$@"
