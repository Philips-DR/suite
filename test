#!/usr/bin/env bash
# Every tool's tests, one after another. None needs a login, a model, audio or the network.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
PY="$(pwd)/.venv/bin/python"
AUDIOBOOK_PY="$(pwd)/audiobook/.venv/bin/python"  # its own environment: torch, Docling, Pocket TTS
failed=()
run() { local name=$1; printf "\n==> %s\n" "$name"; shift; "$@" || failed+=("$name"); }
run assistant bash -c "cd assistant && $PY -m pytest tests -q"
run meet-ai   bash -c "cd meet-ai && $PY -m pytest tests -q"
run mail-ai   bash -c "cd mail-ai && $PY -m pytest tests -q"
run audiobook bash -c "cd audiobook && $AUDIOBOOK_PY -m pytest tests -q"
run docu-ai   bash -c "cd docu-ai && npm test --silent"
run web       bash -c "cd web && npx tsc --noEmit"
echo
if ((${#failed[@]})); then echo "FAILED: ${failed[*]}"; exit 1; fi
echo "All passed."
