#!/usr/bin/env bash
# meet-ai's MCP front door, over stdio. Nothing may be written to stdout but protocol.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# This tool's own environment if it has one; otherwise the suite's, one folder up. So the
# tool runs the same whether it is checked out alone or as part of the suite.
PY="$DIR/.venv/bin/python"
[[ -x "$PY" ]] || PY="$DIR/../.venv/bin/python"
if [[ ! -x "$PY" ]]; then
  echo "No Python environment. In the suite: run ./setup at its top. Alone: python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi

# The server imports transcribe.py and capture.py from the repo root, so it must run there
# regardless of where it was launched from.
cd "$DIR"
exec "$PY" -m meetnotes.mcp_server "$@"
