#!/usr/bin/env bash
# Every login the suite depends on, in one command:
#
#   aws           the model, through Bedrock (AWS SSO; lapses overnight)
#   docu-ai       Google Docs, to build documents
#   mail-ai       Gmail, read-only
#   mail-compose  Gmail, drafting and sending (a separate, wider token; only if set up)
#
#   ./auth               check each login and renew only the ones that are dead
#   ./auth --check       check and report, renew nothing
#   ./auth docu-ai ...   renew the named logins whether or not they look dead
#
# The containers (./start-docker) keep their own copy of each Google token, in data/config. Renewing
# here does not touch it, so a container stayed signed in with a token Google had since let lapse and
# every build failed with invalid_grant (found 2026-10-15). So a login that is good here is also copied
# there when the container's copy holds a different refresh token. --check only reports it.
#
# Checking costs no browser: AWS is asked who we are, and each Google refresh token is
# exchanged once at Google's token endpoint, which is what every tool call does anyway.
# Renewing runs each tool's own auth command from its own folder, so its relative
# credentials.json is found. Nothing needs restarting afterwards: mail-ai reads its token on
# every call and docu-ai notices a new one in its token file.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

[[ -x .venv/bin/python ]] || { echo "Not set up yet. Run ./setup first." >&2; exit 1; }
if [[ -f .env ]]; then set -a; source .env; set +a; fi
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
ALL=(aws docu-ai mail-ai mail-compose)

# Is a Google refresh token still accepted? Prints ok, dead, missing or unknown (no network,
# or an answer we cannot read), and a reason on the second line.
google_check() {  # <client credentials.json> <token.json>
  .venv/bin/python - "$1" "$2" <<'PY'
import json, sys, urllib.parse, urllib.request, urllib.error
client_path, token_path = sys.argv[1:3]
try:
    token = json.load(open(token_path))
except FileNotFoundError:
    print("missing"); print(f"no token at {token_path}"); sys.exit()
except ValueError:
    print("dead"); print(f"unreadable token at {token_path}"); sys.exit()
if not token.get("refresh_token"):
    print("dead"); print("token has no refresh_token"); sys.exit()
try:
    raw = json.load(open(client_path))
    client = raw.get("installed") or raw.get("web") or {}
except (OSError, ValueError):
    print("unknown"); print(f"no OAuth client at {client_path}"); sys.exit()
body = urllib.parse.urlencode({
    "grant_type": "refresh_token", "refresh_token": token["refresh_token"],
    "client_id": token.get("client_id") or client.get("client_id", ""),
    "client_secret": token.get("client_secret") or client.get("client_secret", ""),
}).encode()
try:
    urllib.request.urlopen("https://oauth2.googleapis.com/token", body, timeout=15)
    print("ok"); print("")
except urllib.error.HTTPError as e:
    try: err = json.load(e).get("error", str(e.code))
    except ValueError: err = str(e.code)
    print("dead" if err == "invalid_grant" else "unknown"); print(err)
except OSError as e:
    print("unknown"); print(f"could not reach Google: {e}")
PY
}

check() {  # <name> → sets state and reason
  local out
  case $1 in
    aws)
      if out=$(aws sts get-caller-identity --profile "${AWS_PROFILE:?AWS_PROFILE is not set in .env}" \
                 --query Arn --output text 2>&1); then state=ok; reason=${out##*/}
      else state=dead; reason=$(tail -1 <<<"$out"); fi ;;
    docu-ai)
      out=$(google_check docu-ai/credentials.json "${DOCU_AI_TOKEN:-$CONFIG/docu-ai/token.json}") ;;
    mail-ai)
      out=$(google_check mail-ai/credentials.json "$CONFIG/mail-ai/token.json") ;;
    mail-compose)
      out=$(google_check mail-ai/credentials.json "$CONFIG/mail-ai/token-compose.json") ;;
  esac
  if [[ $1 != aws ]]; then state=$(sed -n 1p <<<"$out"); reason=$(sed -n 2p <<<"$out"); fi
}

# Where each Google token lives on this computer, and where the containers keep their copy.
host_token() {
  case $1 in
    docu-ai)      echo "${DOCU_AI_TOKEN:-$CONFIG/docu-ai/token.json}" ;;
    mail-ai)      echo "$CONFIG/mail-ai/token.json" ;;
    mail-compose) echo "$CONFIG/mail-ai/token-compose.json" ;;
  esac
}
container_token() {
  case $1 in
    docu-ai)      echo data/config/docu-ai/token.json ;;
    mail-ai)      echo data/config/mail-ai/token.json ;;
    mail-compose) echo data/config/mail-ai/token-compose.json ;;
  esac
}

# Print what the containers hold for a login: none (no container setup, or nothing here to give), same,
# stale (a different refresh token), or copied (write mode only). Judged by the refresh token, not the
# file: a container rewrites its file whenever it renews the short-lived access token, so the files differ
# all the time and only the refresh token says whether they are the same login. Written atomically with
# mode 600; nothing is printed of the token itself.
container_sync() {  # <login> <write|report>
  [[ $1 != aws && -d data/config ]] || { echo none; return; }
  .venv/bin/python - "$(host_token "$1")" "$(container_token "$1")" "$2" <<'PY'
import json, os, sys, tempfile
src, dest, mode = sys.argv[1:4]
def refresh_token(path):
    try: return json.load(open(path)).get("refresh_token")
    except (OSError, ValueError): return None
if refresh_token(src) is None: print("none"); sys.exit()
if refresh_token(src) == refresh_token(dest): print("same"); sys.exit()
if mode != "write": print("stale"); sys.exit()
folder = os.path.dirname(dest)
os.makedirs(folder, exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=folder, prefix=".token-")
try:
    with os.fdopen(fd, "wb") as out, open(src, "rb") as source: out.write(source.read())
    os.chmod(tmp, 0o600); os.replace(tmp, dest); print("copied")
except BaseException:
    try: os.unlink(tmp)
    except OSError: pass
    raise
PY
}

# Say, under a login that is good here, what the containers hold for it.
container_note() {  # <login> <write|report>
  local did; did=$(container_sync "$1" "$2")
  case $did in
    copied) echo "                         -> copied to $(container_token "$1") for the containers" ;;
    stale)  echo "                         -> the containers hold an older login; ./auth (no flags) updates them" ;;
  esac
}

renew() {
  case $1 in
    aws)          aws sso login --profile "$AWS_PROFILE" ;;
    docu-ai)      (cd docu-ai && npm run --silent auth) ;;
    mail-ai)      (cd mail-ai && ./mail auth) ;;
    mail-compose) (cd mail-ai && ./mail auth --compose) ;;
  esac
}

mode=auto; targets=()
for arg in "$@"; do
  case $arg in
    --check) mode=check ;;
    -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    aws|docu-ai|mail-ai|mail-compose) targets+=("$arg"); mode=force ;;
    *) echo "unknown login: $arg (one of: ${ALL[*]})" >&2; exit 1 ;;
  esac
done
((${#targets[@]})) || targets=("${ALL[@]}")

failed=()
for name in "${targets[@]}"; do
  if [[ $mode == force ]]; then state=forced; reason=""
  else check "$name"; fi
  printf '  %-13s %-8s %s\n' "$name" "$state" "$reason"
  if [[ $mode == check ]]; then
    if [[ $state == ok ]]; then container_note "$name" report; else failed+=("$name"); fi
    continue
  fi
  # A compose token that was never made is a choice, not a failure; ask for it by name.
  [[ $name == mail-compose && $state == missing && $mode == auto ]] && continue
  if [[ $state == dead || $state == missing || $state == forced ]]; then
    printf '\n==> signing in: %s\n' "$name"
    if renew "$name"; then check "$name"; printf '  %-13s %-8s %s\n\n' "$name" "$state" "$reason"
    else state=failed; fi
    [[ $state == ok ]] || failed+=("$name")
  elif [[ $state != ok ]]; then
    failed+=("$name")
  fi
  # A login that is good here is good for the containers too, once they hold the same refresh token.
  [[ $state == ok ]] && container_note "$name" write
done

if ((${#failed[@]})); then echo "Not signed in: ${failed[*]}"; exit 1; fi
echo "All logins good."
